@page "/"
@using N_m3u8DL_RE.Web.Services
@inject BrowserParserService ParserService
@inject IJSRuntime JS

<PageTitle>N_m3u8DL-RE Web</PageTitle>

<h1>N_m3u8DL-RE Web</h1>

<p>Browser-side parser façade powered by the shared parser library. The page uses pinned upstream browser assets for a predictable update path and exposes the available toolchain compatibility summary below.</p>

<div class="mb-3">
    <label class="form-label">Playlist URL</label>
    <input class="form-control" @bind="InputUrl" placeholder="https://example.com/index.m3u8" />
</div>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary" @onclick="ParseAsync">Parse playlist</button>
    <button class="btn btn-secondary" @onclick="LoadFfmpegAsync">Load ffmpeg.wasm</button>
    <button class="btn btn-outline-secondary" @onclick="ShowToolchainAsync">Show browser compatibility</button>
</div>

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info mt-3">@StatusMessage</div>
}

@if (ToolchainStatus is not null)
{
    <div class="alert alert-secondary mt-3">
        <strong>Browser compatibility</strong>
        <ul class="mb-0">
            @foreach (var item in ToolchainStatus)
            {
                <li>@item</li>
            }
        </ul>
    </div>
}

@if (Result is not null)
{
    <div class="mt-3">
        <h2>Streams</h2>
        <ul>
            @foreach (var item in Result.Streams)
            {
                <li>
                    <strong>@item.MediaType</strong> - @item.Language - @item.Resolution - @item.Codecs - @item.GroupId
                    <br />
                    <span class="text-muted">@item.Url</span>
                </li>
            }
        </ul>
    </div>
}

@code {
    private string InputUrl = "https://storage.googleapis.com/shaka-demo-assets/angel-one-hls/hls.m3u8";
    private string StatusMessage = string.Empty;
    private BrowserParseResult? Result;
    private IReadOnlyList<string>? ToolchainStatus;

    private async Task ParseAsync()
    {
        try
        {
            StatusMessage = "Parsing...";
            Result = await ParserService.ParseAsync(InputUrl);
            StatusMessage = $"Parsed {Result.Streams.Count} stream(s) using {Result.ExtractorType}.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }
    }

    private async Task LoadFfmpegAsync()
    {
        try
        {
            StatusMessage = "Loading ffmpeg.wasm...";
            await JS.InvokeVoidAsync("window.nm3u8dlWeb.loadFfmpegWasm");
            StatusMessage = "ffmpeg.wasm is available through the browser bridge.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }
    }

    private async Task ShowToolchainAsync()
    {
        try
        {
            var summary = await JS.InvokeAsync<IReadOnlyList<string>>("window.nm3u8dlWeb.getToolchainSummary");
            ToolchainStatus = summary;
            StatusMessage = "Browser toolchain compatibility summary refreshed.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }
    }
}
